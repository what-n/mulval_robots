/******************************************************/
/****         Interaction Rules                   *****/
/******************************************************/

/************** dos attack *************/

interaction_rule(
  (dos_attack(H1, H2, Protocol, Port) :-
  vulExists(H2, _, Software, remoteExploit, dos_flood),
	networkServiceInfo(H2, Software, Protocol, Port, Perm),
  hacl(H1, H2, Protocol, Port),
	netAccess(H1, Protocol, Port)),
  rule_desc('dos(flood) attack',
  1.0)).

interaction_rule(
  (dos_attack(H1, H2, Protocol, Port) :-
  vulExists(H3, _, Software, remoteExploit, dos_amplification),
	networkServiceInfo(H3, Software, Protocol, Port, Perm),
	hacl(H1, H3, Protocol, Port),
  hacl(H3, H2, Protocol, Port),
  netAccess(H1, Protocol, Port)),
  rule_desc('dos(amplification) attack',
  1.0)).

/************** reply attack *************/
interaction_rule(
  (reply_attack(H3, H1, H2, Protocol, Port) :-
  vulExists(H2, _, Software, remoteExploit, reply),
	networkServiceInfo(H2, Software, Protocol, Port, Perm),
	hacl(H1, H2, Protocol, Port),
  hacl(H3, H2, Protocol, Port),
  netAccess(H3, Protocol, Port)),
  rule_desc('reply attack',
  1.0)).

/************** inject attack *************/
interaction_rule(
  (inject_attack(H, Perm) :-
	vulExists(H, _, Software, remoteExploit, inject),
	networkServiceInfo(H, Software, Protocol, Port, Perm),
	netAccess(H, Protocol, Port)),
  rule_desc('inject attack',
  1.0)).

interaction_rule(
  (execCode(H, Perm) :-
	inject_attack(H, Perm)),
  rule_desc('inject_attack lead to exploit',
  1.0)).




